<?xml version="1.0" encoding="utf-8"?>
<!-- Android 6 a 11: nada se respalda (allowBackup="false"); se excluye todo por si acaso. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
