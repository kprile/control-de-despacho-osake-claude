# Copia este archivo como .env y ajusta los valores. Las variables ya definidas en el entorno tienen prioridad.

# Interfaz de escucha. Deja 127.0.0.1 si hay un proxy HTTPS delante; usa 0.0.0.0 para exponerlo en la red local.
HOST=127.0.0.1

# Puerto HTTP.
PORT=4317

# Origen(es) canónico(s) desde donde se usa la app, separados por coma. Se valida contra Origin/Referer
# en cada POST. Si el primero empieza con https:// la cookie de sesión lleva Secure.
# Para el emulador Android agrega: http://10.0.2.2:4317
PUBLIC_ORIGIN=http://127.0.0.1:4317

# Si se define, el alta inicial (POST /api/setup) exige este código. Recomendado en servidores públicos.
SETUP_TOKEN=

# Secreto compartido con Mercat (encabezado X-Webhook-Secret). Sin él, el webhook responde 503.
MERCAT_WEBHOOK_SECRET=

# Ruta del archivo SQLite.
DB_PATH=data/despachos.sqlite

# Duración de la sesión en días.
SESSION_DAYS=14

# ---- Copia automática a Google Sheets (opcional, solo lectura para el negocio) ----
# Sin GOOGLE_SHEETS_ID o sin GOOGLE_SERVICE_ACCOUNT_FILE la copia queda deshabilitada.
# ID de la hoja: la parte entre /d/ y /edit en https://docs.google.com/spreadsheets/d/<ID>/edit
# GOOGLE_SHEETS_ID=
# Ruta en el servidor al JSON de la clave de la cuenta de servicio. Fuera del repositorio; nunca subirla.
# GOOGLE_SERVICE_ACCOUNT_FILE=/etc/despachos/credenciales/service-account.json
# Segundos mínimos entre copias cuando hay cambios (defecto 60).
# GOOGLE_SHEETS_INTERVAL_SECONDS=60
# Días de pedidos que se copian a la pestaña Pedidos (defecto 90).
# GOOGLE_SHEETS_DAYS=90
